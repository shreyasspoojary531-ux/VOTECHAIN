DATABASE_URL="postgresql://votechain:password@postgres:5432/votechain"
PORT=5000
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=1d
OTP_EXPIRY_MINUTES=5
OTP_PEPPER=replace_with_secure_pepper
CORS_ORIGIN=http://localhost:3000
FABRIC_CHANNEL=votechannel
FABRIC_CHAINCODE=votechain
FABRIC_NETWORK=./blockchain/network
# Demo: run the in-process simulated Fabric gateway instead of a real network
SIMULATED_BLOCKCHAIN=true
